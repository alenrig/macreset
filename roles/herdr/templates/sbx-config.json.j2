{
  "agentKind": "pi",
  "customAgents": {
    "pi": {
      "title": "Pi",
      "sbxAgent": "shell",
      "command": ["bash", "-lc", "export PATH=\"$HOME/.local/node-v22.19.0/bin:$PATH\"; exec \"$HOME/.local/bin/pi\" \"$@\"", "--"],
      "defaultArgs": ["--provider", "ollama", "--model", {{ local_llm_model | to_json }}],
      "herdrDetectionKind": null,
      "setupScript": {{ lookup('ansible.builtin.template', role_path ~ '/templates/pi-sandbox-setup.sh.j2') | to_json }}
    }
  }
}
