set -eu

# The shell workload does not promise a Pi runtime. Pin a compatible Node
# release if the sandbox does not already have Node.js 22.19 or newer.
export PATH="$HOME/.local/bin:$HOME/.local/node-v22.19.0/bin:$PATH"
if ! command -v node >/dev/null 2>&1 || ! node -e 'const [major, minor] = process.versions.node.split(".").map(Number); process.exit(major > 22 || major === 22 && minor >= 19 ? 0 : 1)' >/dev/null 2>&1; then
  case "$(uname -m)" in
    x86_64) node_arch=x64 ;;
    aarch64|arm64) node_arch=arm64 ;;
    *) echo 'Pi sandbox requires Linux x86_64 or arm64 for Node.js' >&2; exit 1 ;;
  esac
  node_archive="node-v22.19.0-linux-$node_arch.tar.xz"
  curl -fsSL "https://nodejs.org/dist/v22.19.0/$node_archive" -o "/tmp/$node_archive"
  mkdir -p "$HOME/.local/node-v22.19.0"
  tar -xJf "/tmp/$node_archive" -C "$HOME/.local/node-v22.19.0" --strip-components=1
fi

curl -fsSL https://pi.dev/install.sh -o /tmp/pi-install.sh
sh /tmp/pi-install.sh </dev/null
"$HOME/.local/bin/pi" --version

mkdir -p "$HOME/.pi/agent"
cat > "$HOME/.pi/agent/models.json" <<'PI_MODELS_JSON'
{"providers":{"ollama":{"baseUrl":"http://host.docker.internal:11434/v1","api":"openai-completions","apiKey":"ollama","models":[{"id":{{ local_llm_model | to_json }},"contextWindow":{{ local_llm_context_length | int }}]}}}
PI_MODELS_JSON
cat > "$HOME/.pi/agent/settings.json" <<'PI_SETTINGS_JSON'
{"defaultProvider":"ollama","defaultModel":{{ local_llm_model | to_json }}}
PI_SETTINGS_JSON
